server.port=8081
#app.timezone=America/New_York
server.database.timezone=UTC

server.servlet.context.path=/v1
spring.application.name=q4magic

spring.datasource.url=jdbc:mysql://localhost:3306/q4magic
spring.datasource.username=root
spring.datasource.password=your_db_password
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.database=MYSQL
#spring.jpa.show-sql=true

# AuthId.ai
authIdExternalId=your_authid_external_id
authIdApiKeyValue=your_authid_api_key
authIdAccountNumberStart=local-360pipe

#SF configuration
sf.client-id=your_salesforce_client_id
sf.client-secret=your_salesforce_client_secret
sf.login-url=https://login.salesforce.com
sf.redirect-url=http://localhost:3000/dashboard/mycrm
salesforce.api.version=v60.0

openai.api.key=your_openai_api_key


##Email Configuration
spring.mail.default-encoding=UTF-8
spring.mail.host=smtp.gmail.com
spring.mail.username=your_email@gmail.com
spring.mail.password=your_email_app_password
spring.mail.port=587
spring.mail.protocol=smtp
spring.mail.test-connection=false

spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.ssl.trust=smtp.gmail.com
spring.mail.properties.mail.from=your_email@gmail.com
spring.mail.properties.mail.fromName=360Pipe-Support
logging.level.org.springframework.mail=DEBUG
spring.mail.properties.mail.debug=true

#JWT Integration
app.JWT.SECRET_KEY=your_jwt_secret_key
siteUrl=http://localhost:3000/
serverurl=http://localhost:8081/

# in milliseconds (120000 ms = 2 minutes)
#jwt.expiration=120000

# for 12 hours
jwt.expiration=43200000

# Reset password token expiration (15 minutes)
token.reset.expiration=900000

# Sub user account setup token expiration (24 hours)
token.subuser.expiration=86400000

#ZeroBounce Email Verification Settings
zeroBounceBaseUrl=https://api.zerobounce.net/v2/
zeroBounceApiKey=your_zerobounce_api_key

#Proofy Email Verification Settings
proofyBaseUrl=https://api.proofy.io/
proofyApiKey=your_proofy_api_key
proofyAId=your_proofy_aid

#C:/xampp/htdocs/timeSheetPro/usercontent/
360pipeDrive=C:/xampp/htdocs/360pipe/usercontent/
imageContextPath=http://localhost/360pipe/usercontent/
spring.servlet.multipart.enabled=true
spring.servlet.multipart.file-size-threshold=1KB
spring.servlet.multipart.max-file-size=1GB
spring.servlet.multipart.max-request-size=1GB

#AuthorizeNet payment gateway info
envsys=local
authorizenet.loginId=your_authorizenet_login_id
authorizenet.transactionKey=your_authorizenet_transaction_key
#mike@
authorizenet.productionLoginId=your_authorizenet_production_login_id
authorizenet.productionTransactionKey=your_authorizenet_production_transaction_key

#company info
companyName=360pipe
mainCompanyName=Kaiasoft Inc
siteUrlAddressBr=6701 Koll Center Parkway #250 <br>Pleasanton, California 94566
companyNumber=415-906-4001 Ext 2
siteUrlWWW=
siteUrlWWWDisplay=
siteUrlAddress=

#Google Calendar
#google.calendar.clientId=your_google_calendar_client_id
#google.calendar.clientSecret=your_google_calendar_client_secret
