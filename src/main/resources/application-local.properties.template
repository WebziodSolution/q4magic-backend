google.calendar.redirectUri=${siteUrl}googlecalendaroauthredirect
google.calendar.calendarApiUri=https://www.googleapis.com/calendar/v3/calendars/primary/

#Outlook Calendar
outlook.client.clientId=your_outlook_client_id
outlook.client.clientSecret=your_outlook_client_secret
outlook.client.redirectUri=${siteurl}outlookcalendaroauthredirect
outlook.client.scope=offline_access User.Read Calendars.ReadWrite MailboxSettings.Read
outlook.client.calendarAuthorizeApiUri=https://login.microsoftonline.com/common/oauth2/v2.0/
outlook.client.calendarApiUri=https://graph.microsoft.com/v1.0/me/calendar/

icsdownload-dir=C:/xampp/htdocs/360pipe/ics_download/

siteNameBigCom=devwebapp.360pipe.com

logging.level.org.apache.http.client.protocol.ResponseProcessCookies=ERROR
